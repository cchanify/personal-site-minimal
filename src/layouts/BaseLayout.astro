---
import '../styles/global.css';
import '../styles/dark-mode.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogUrl?: string;
  activeNav?: 'about' | 'ai' | 'links' | 'security' | 'blog';
  ogType?: 'website' | 'article';
}

const { title, description, canonicalUrl, ogUrl, activeNav, ogType = 'website' } = Astro.props;
const resolvedCanonical = canonicalUrl ?? new URL(Astro.url.pathname, Astro.site).toString();
const resolvedOgUrl = ogUrl ?? resolvedCanonical;

const GOATCOUNTER_CODE = 'connorhanify';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#ffffff">
    <script is:inline src="/theme.js"></script>
    <script is:inline data-goatcounter={`https://${GOATCOUNTER_CODE}.goatcounter.com/count`} async src="https://gc.zgo.at/count.js"></script>

    <meta name="description" content={description}>
    <meta name="author" content="Connor Hanify">
    <title>{title}</title>

    <meta property="og:type" content={ogType}>
    <meta property="og:url" content={resolvedOgUrl}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content="https://connorhanify.com/og.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content={resolvedOgUrl}>
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content="https://connorhanify.com/og.png">

    <link rel="canonical" href={resolvedCanonical}>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="alternate" type="application/rss+xml" title="Connor Hanify" href="/rss.xml">

    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="site-wrapper">
      <header>
        <div>
          <a class="site-title" href="/">connor hanify</a>
          <p class="tagline">Security Engineer · Incident Response · Cloud Security</p>
        </div>
        <nav>
          <a class:list={['nav-link', { active: activeNav === 'about' }]} aria-current={activeNav === 'about' ? 'page' : undefined} href="/">about</a>
          <a class:list={['nav-link', { active: activeNav === 'blog' }]} aria-current={activeNav === 'blog' ? 'page' : undefined} href="/blog/">blog</a>
          <a class:list={['nav-link', { active: activeNav === 'ai' }]} aria-current={activeNav === 'ai' ? 'page' : undefined} href="/ai/">ai</a>
          <a class:list={['nav-link', { active: activeNav === 'links' }]} aria-current={activeNav === 'links' ? 'page' : undefined} href="/links/">links</a>
          <a class:list={['nav-link', { active: activeNav === 'security' }]} aria-current={activeNav === 'security' ? 'page' : undefined} href="/security/">security</a>
          <button class="theme-toggle" type="button" aria-label="Toggle dark mode">🌙</button>
        </nav>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer>
        <a href="mailto:connorchanify@gmail.com">Email</a>
        <a href="https://github.com/cchanify" target="_blank" rel="noopener">Github</a>
        <a href="https://www.linkedin.com/in/connor-hanify-848063114/" target="_blank" rel="noopener">LinkedIn</a>
        <a href="/rss.xml">RSS</a>
      </footer>
    </div>
  </body>
</html>
